{
  "name": "@flow/apps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The page of an app installed in the organization, at /apps/<name> (docs/specs/user-apps.md §6): the suite bar and the app's screen in a sandboxed frame from its own origin.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@flow/suite-bar": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "lucide-react": "^1.67.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
