{
  "name": "universal-docs",
  "version": "0.2.37",
  "private": true,
  "type": "module",
  "bin": {
    "mcp-docs-dev": "desktop/cli.js"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --watch-path=server --watch-path=shared server/index.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/prerender-landing.ts && vite build --config plugin/vite.config.ts",
    "start": "NODE_ENV=production node server/supervise.ts",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "plugin:dev": "node --watch --watch-path=plugin/server --watch-path=server --watch-path=shared plugin/server/index.ts",
    "plugin:start": "NODE_ENV=production node plugin/server/index.ts",
    "plugin:build": "vite build --config plugin/vite.config.ts",
    "plugin:watch": "vite build --config plugin/vite.config.ts --watch",
    "plugin:package": "mkdir -p release && rm -f release/universal-docs-plugin.zip && cd plugin && zip -r -X ../release/universal-docs-plugin.zip plugin.json mcp.json skills assets",
    "plugin:harness": "vite --config plugin/vite.config.ts",
    "r2": "node server/scripts/r2.ts",
    "desktop": "vite build && node desktop/cli.js",
    "desktop:start": "node desktop/cli.js",
    "desktop:win": "vite build && electron-builder --win --x64",
    "desktop:pack": "vite build && electron-builder --dir",
    "desktop:mac": "vite build && electron-builder --mac --dir && codesign --force --deep --sign - \"release/mac-arm64/MCP Docs.app\" && cd release && rm -f MCP-Docs-$npm_package_version-mac-arm64.zip && ditto -c -k --sequesterRsrc --keepParent \"mac-arm64/MCP Docs.app\" MCP-Docs-$npm_package_version-mac-arm64.zip",
    "aws:secret": "node scripts/aws-secret.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "@anthropic-ai/sdk": "^0.131.0",
    "@ascentsparksoftware/react-image-editor": "file:vendor/ascentsparksoftware-react-image-editor-1.1.0-freeflow.2.tgz",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@cantoo/pdf-lib": "^2.11.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@imgly/background-removal": "^1.7.0",
    "@llamaindex/liteparse": "^2.15.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/mcp-extensions": "^0.1.0",
    "@types/mdast": "^4.0.4",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "github-markdown-css": "^5.9.0",
    "jszip": "^3.10.2",
    "marked": "^16.4.2",
    "mermaid": "11.17.2",
    "onnxruntime-web": "^1.21.0",
    "openai": "^7.30.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "signature_pad": "^5.1.4",
    "unified": "^11.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/freeflow-im/mcp-docs.git"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "desktop/main.js",
  "description": "MCP Docs: spreadsheets, documents and presentations",
  "author": "FreeFlow",
  "build": {
    "appId": "im.freeflow.docs",
    "productName": "MCP Docs",
    "protocols": [
      {
        "name": "MCP Docs",
        "schemes": [
          "mcpdocs"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "package.json",
      "desktop/**",
      "server/**",
      "shared/**",
      "client/src/**",
      "plugin/server/**",
      "dist/client/**",
      "!**/*.test.ts",
      "!**/*.test.tsx",
      "!dist/client/marketing/**",
      "!server/fixtures/**",
      "!server/scripts/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/pdfjs-dist/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/@llamaindex/liteparse/*.node",
      "!node_modules/@llamaindex/liteparse/*.so"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "MCP-Docs-${version}-win-x64-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dir",
      "identity": null,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "MCP Docs Spreadsheet",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "im.freeflow.docs.sheet"
            ]
          },
          {
            "CFBundleTypeName": "MCP Docs Presentation",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "im.freeflow.docs.slides"
            ]
          },
          {
            "CFBundleTypeName": "MCP Docs Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "im.freeflow.docs.doc"
            ]
          },
          {
            "CFBundleTypeName": "Markdown Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "net.daringfireball.markdown"
            ]
          },
          {
            "CFBundleTypeName": "CSV File",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "public.comma-separated-values-text"
            ]
          },
          {
            "CFBundleTypeName": "Office Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "org.openxmlformats.wordprocessingml.document",
              "org.openxmlformats.spreadsheetml.sheet",
              "org.openxmlformats.presentationml.presentation",
              "com.microsoft.excel.xls"
            ]
          },
          {
            "CFBundleTypeName": "PDF Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          },
          {
            "CFBundleTypeName": "Picture",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.png",
              "public.jpeg",
              "org.webmproject.webp"
            ]
          },
          {
            "CFBundleTypeName": "GIF Picture",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.compuserve.gif"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "im.freeflow.docs.sheet",
            "UTTypeDescription": "MCP Docs Spreadsheet",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "ffsheet"
              ]
            }
          },
          {
            "UTTypeIdentifier": "im.freeflow.docs.slides",
            "UTTypeDescription": "MCP Docs Presentation",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "ffslides"
              ]
            }
          },
          {
            "UTTypeIdentifier": "im.freeflow.docs.doc",
            "UTTypeDescription": "MCP Docs Document",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "ffdoc"
              ]
            }
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "net.daringfireball.markdown",
            "UTTypeDescription": "Markdown Document",
            "UTTypeConformsTo": [
              "public.plain-text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "md",
                "markdown"
              ],
              "public.mime-type": [
                "text/markdown"
              ]
            }
          }
        ]
      }
    }
  }
}
