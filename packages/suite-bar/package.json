{
  "name": "@flow/suite-bar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The FreeFlow suite bar: the 56px bar above Chat and Docs (docs/specs/freeflow-suite.md \u00a72.5), and the assistant dock the apps share (AssistantDock.tsx). Sources only; each client bundles it.",
  "exports": {
    ".": "./src/index.ts",
    "./intents": "./src/lib/intents.ts",
    "./assistant-dock": "./src/AssistantDock.tsx",
    "./assistant-chat": "./src/AssistantChat.tsx"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@flow/shared": "workspace:*",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "^30.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
