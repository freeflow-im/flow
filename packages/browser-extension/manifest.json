{
  "manifest_version": 3,
  "name": "FreeFlow Browser (prototype)",
  "description": "Lets your FreeFlow assistant open and use web pages in this browser, in its own tab group.",
  "version": "0.0.1",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "FreeFlow agent: click to stop it and close its tabs" },
  "permissions": ["tabs", "tabGroups", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://app.freeflow.im/*"]
  }
}
